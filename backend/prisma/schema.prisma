// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
enum Rol {
  ESTUDIANTE
  EMPRESA
  COORDINACION
}

enum Disponibilidad {
  TIEMPO_COMPLETO
  TIEMPO_PARCIAL
  SOLO_PROYECTOS
}

enum EstadoValidacion {
  PENDIENTE
  VALIDADO
  RECHAZADO
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?
  tokenVersion Int    @default(0) // sube al cambiar la contraseña: invalida sesiones anteriores
  fotoArchivo  String?  // nombre del archivo en la carpeta de subidas
  fotoTipo     String?  // tipo MIME de la foto (image/jpeg, image/png o image/webp)
  totpActivo        Boolean  @default(false) // autenticación en dos pasos activa
  totpSecretoCifrado String? // secreto TOTP cifrado (AES-256-GCM)
  codigosRespaldo   String[] @default([]) // hashes SHA-256 de los códigos de respaldo sin usar
  nombre       String
  rol          Rol      @default(ESTUDIANTE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  perfil        PerfilEstudiante?
  validaciones  ValidacionProyecto[]
}

model PerfilEstudiante {
  id                 Int             @id @default(autoincrement())
  userId             Int             @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  carnet             String?          @unique
  porcentajeAvance   Int             @default(0)
  historialAcademico String?
  disponibilidad     Disponibilidad?
  habilidades        String[]        @default([])

  proyectos Proyecto[]
}

model Proyecto {
  id               Int              @id @default(autoincrement())
  perfilId         Int
  perfil           PerfilEstudiante @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  titulo           String
  descripcion      String
  urlRepositorio   String?
  urlDemo          String?
  urlDocumentacion String?
  tecnologias      String[]         @default([])
  estadoValidacion EstadoValidacion @default(PENDIENTE)
  publicado        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  validacion ValidacionProyecto?
}
model ValidacionProyecto {
  id            Int      @id @default(autoincrement())
  proyectoId    Int      @unique
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  coordinadorId Int
  coordinador   User     @relation(fields: [coordinadorId], references: [id])
  comentario    String?
  createdAt     DateTime @default(now())
}
